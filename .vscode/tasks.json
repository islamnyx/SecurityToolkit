{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build Security Suite (Full Project)",
            "command": "C:\\msys64\\ucrt64\\bin\\gcc.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "main.c", 
                "audit.c", 
                "encryption.c", 
                "math_tools.c", 
                "user.c", 
                "logs.c",
                "-Iinclude",
                "-o",
                "${fileDirname}\\security_suite.exe",
                "-lm"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compiles all modules in the SecurityToolkit project."
        }
    ],
    "version": "2.0.0"
}